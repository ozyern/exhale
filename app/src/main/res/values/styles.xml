<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Exhale" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Pure black under the first frame so cold start never flashes white before the
             Compose BootSplash layer composes — the system splash, the window and the
             Compose splash are all the same color, reading as ONE seamless boot screen. -->
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:enforceNavigationBarContrast" tools:ignore="NewApi">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Android 12+ SplashScreen API (minSdk 33): plain black. BootSplash's disc springs in
             out of nothing, so the launch window shows nothing but the black it springs out of. -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
    </style>
</resources>
