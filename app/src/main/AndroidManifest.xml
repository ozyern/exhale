<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        Lets the in-app updater hand a downloaded APK to the system installer. This only grants the
        ability to *ask*: on API 26+ the user must still allow this app to install unknown apps,
        which Updater.installApk checks for and Updater.requestInstallPermission sends them to.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
        <!-- ColorOS Live Lyrics Bridge: without this Android 11+ hides it, the check always said
             "not installed", and the per-line subtitle kept rewriting metadata under a lock
             screen that was trying to draw the lyric document. -->
        <package android:name="io.github.andrealtb.lockscreenlyrics" />
    </queries>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:appCategory="audio"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_gold"
        android:roundIcon="@mipmap/ic_launcher_gold"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.Exhale"
        tools:targetApi="tiramisu">
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <!--
            OxygenOS / ColorOS "Live Space" opt-in.

            Stock ColorOS keeps a whitelist of players allowed into its media-history stack, which
            is what keeps the lock-screen music card (and its lyric surface) alive after our
            process has been fully stopped. This flag asks to be admitted alongside it. It is inert
            on every other ROM — an unread meta-data string — and grants nothing by itself: the
            lyrics themselves travel as `lyricInfo` on the media session. See OplusLiveLyrics.
        -->
        <meta-data
            android:name="io.github.andrealtb.lockscreenlyrics.OPLUS_MEDIA_HISTORY"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:theme="@style/Theme.Exhale"
            android:windowSoftInputMode="adjustResize">
            <!--
                MAIN/LAUNCHER used to live here. It moved to the two <activity-alias> entries at
                the bottom of this file so the launcher icon can be swapped at runtime: a
                component's icon is fixed at install time, but WHICH component the launcher shows
                is not, so an app icon picker is really an alias picker. Everything else this
                activity answers to — VIEW, MUSIC_PLAYER, the deep links below — stays on the
                activity itself, because those are about what it can open, not about how it is
                listed.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.MUSIC_PLAYER" />

                <category android:name="android.intent.category.APP_MUSIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="together"
                    android:scheme="exhale" />
            </intent-filter>

            <!-- Youtube filter -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="music.youtube.com" />
                <!-- video prefix -->
                <data android:pathPrefix="/v/" />
                <data android:pathPrefix="/embed/" />
                <data android:pathPrefix="/watch" />
                <!-- channel prefix -->
                <data android:pathPrefix="/channel/" />
                <data android:pathPrefix="/user/" />
                <data android:pathPrefix="/c/" />
                <!-- playlist prefix -->
                <data android:pathPrefix="/playlist" />
                <!-- browse prefix -->
                <data android:pathPrefix="/browse/" />
                <!-- search prefix -->
                <data android:pathPrefix="/search" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
                <data android:pathPrefix="/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="vnd.youtube" />
                <data android:scheme="vnd.youtube.launch" />
            </intent-filter>

            <!-- Open with: song files from a file manager, a download or an attachment -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/x-flac" />
            </intent-filter>

            <!-- Share filter -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <service
            android:name=".playback.MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <service
            android:name=".playback.ExoDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.ExhalePlayerWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/exhale_player_widget" />
        </receiver>

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/status" />

        <activity
            android:name=".playback.LockScreenLyricsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.ozyern.exhale.locklyrics"
            android:showWhenLocked="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Exhale" />

        <activity
            android:name=".DebugActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.Exhale">
        </activity>

        <activity
            android:name=".ui.screens.settings.PoTokenExtractionActivity"
            android:exported="false"
            android:theme="@style/Theme.Exhale" />
        <!--
            App icon packs.
            ==============

            Exactly one of these is enabled at a time; the enabled one is the app's entry in the
            launcher and supplies its icon. `AppIconPack.apply()` flips them with
            PackageManager.setComponentEnabledSetting.

            Both are `targetActivity=".MainActivity"`, so this changes nothing about what launching
            the app does — an alias is a second name for the same activity, not a second activity.

            Gold is `enabled="true"` in the manifest and the older mark is not, which makes the
            gold mark the state a fresh install boots into and the state the app falls back to if
            the stored preference is ever unreadable. `AppIconPack.DEFAULT_PACK` is the other half
            of that statement and has to agree with it, because `current()` reads
            COMPONENT_ENABLED_STATE_DEFAULT as "whatever the manifest said".

            The alias names do not track the labels. `.MainActivityDefault` is the older, black-on-
            gold mark, now shown as "Classic": an alias name is a public component identity, and
            renaming it would orphan every home-screen shortcut pinned to it.

            The pack also decides the mark in the app bar and on the boot splash (see
            AppIconPack), so this is the one place the choice is recorded and everywhere else
            reads it back from PackageManager.

            Caveat worth knowing before touching this: on most launchers the icon visibly
            disappears and comes back when the alias flips, and a home-screen shortcut pinned to
            the old alias can be left dead. That is inherent to the technique, not a bug here, and
            it is why the picker says so out loud.
        -->
        <activity-alias
            android:name=".MainActivityDefault"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityGold"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_gold"
            android:roundIcon="@mipmap/ic_launcher_gold"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
